    "PatientAge": {
      "description": "Patient age in completed years at the clinically relevant breast cancer/radiotherapy time point documented in the record. Prefer an explicitly stated age; do not calculate unless date of birth and the relevant treatment date are both explicitly available.",
      "type": [
        "integer",
        "null"
      ]
    },
    "Stage": {
      "description": "Overall breast cancer stage/group exactly as documented, for example Stage 0, I, IA, IIA, IIIA, IV. Do not infer a stage group from TNM unless the stage group itself is documented.",
      "type": [
        "string",
        "null"
      ]
    },
    "YearRadiotherapyBegin": {
